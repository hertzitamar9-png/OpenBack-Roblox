local ok, settings = pcall(require, "../src/shared/CameraSettings")
assert(ok, "CameraSettings must exist")
local centre = {0, 4, 0}
local top = settings.forView("overhead", centre, 100)
local angled = settings.forView("3d", centre, 100)
assert(top.eye[2] > 100 and math.abs(top.eye[3]) < 3, "overhead must look almost straight down")
assert(angled.eye[2] > 4 and angled.eye[2] < 100 and angled.eye[3] > 40, "3D must reveal depth")
assert(top.focus[2] == 4 and top.focus ~= centre, "settings must copy the focus")
assert(settings.forView("3d", centre, 1).distance == 40, "zoom cannot enter scene")
assert(settings.forView("3d", centre, 1000).distance == 220, "zoom cannot lose scene")
assert(not pcall(settings.forView, "bad", centre, 100), "unknown mode rejected")
assert(not pcall(settings.forView, "3d", {0,0/0,0}, 100), "NaN focus rejected")
assert(not pcall(settings.forView, "3d", centre, math.huge), "infinite zoom rejected")
assert(settings.framing(414,896,150).initialDistance == 220, "Portrait starts wide enough for all unit columns")
assert(settings.framing(896,414,150).initialDistance == 150, "Landscape keeps showcase scale")
assert(settings.framing(896,414,150).lift > 30, "Camera reserves room below preview header")
assert(not pcall(settings.framing, 0,414,150), "Zero viewport rejected")
assert(not pcall(settings.framing, 896,math.huge,150), "Nonfinite viewport rejected")
assert(settings.framing(896,414,150).distance == 150 and settings.framing(414,896,150).distance == 220, "Rotation refits the current viewport")
assert(settings.framing(414,896,60).distance == 88, "Portrait preserves user zoom ratio")
assert(settings.framing(896,414,60).distance == 60, "Rotating back restores user zoom")
assert(settings.zoomForPinch(150,2) == 75, "Pinching out zooms in")
assert(settings.zoomForPinch(150,0.5) == 220, "Pinching in remains bounded")
assert(not pcall(settings.zoomForPinch,150,0), "Zero pinch rejected")
assert(not pcall(settings.zoomForPinch,150,0/0), "NaN pinch rejected")
assert(settings.framing(390,844,150,202).lift > settings.framing(390,844,150,144).lift, "Compact UI reserves more scene space")
print("Camera: view geometry, copies, zoom limits, pinch and responsive framing PASS")
assert(math.abs(settings.framing(896,414,150,70,116).lift) < 1, "Landscape match centres between both HUD bars")
assert(not pcall(settings.framing,896,414,150,70,-1), "Invalid footer rejected")
