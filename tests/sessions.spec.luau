local Rules = require("../src/shared/MatchRules")
local Sessions = require("../src/shared/MatchSessions")
local sessions = Sessions.new(Rules)
assert(sessions:queue(101))
assert(not sessions:queue(101))
local state,meta = sessions:snapshot(101)
assert(not state and meta.queued)
assert(sessions:queue(202))
local a = sessions:snapshot(101)
local b = sessions:snapshot(202)
assert(a.matchId == b.matchId and a.seat == 1 and b.seat == 2 and a.mode == "duel")
assert(#sessions.waiting == 0)
assert(not sessions:attack(202,2))
assert(sessions:attack(202,95))
assert(sessions:attack(101,2))
assert(sessions:snapshot(101).tiles[95] == 2)
b.tiles[1] = 2; b.players[1].gold = 100000
assert(sessions:snapshot(101).tiles[1] == 1 and sessions:snapshot(101).players[1].gold == 0)
assert(not sessions:solo(101) and not sessions:queue(101))
for _=1,10 do sessions:step() end
assert(Rules.count(sessions.members[202].match.state,2) == 2,"No bot in human duel")
assert(sessions:solo(303))
assert(type(sessions.recipients) == "function","Session-specific recipient routing is missing")
local recipients = sessions:recipients(101)
assert(#recipients == 2 and recipients[1] == 101 and recipients[2] == 202)
assert(#sessions:recipients(303) == 1 and sessions:recipients(303)[1] == 303)
assert(#sessions:recipients(999) == 0)
assert(sessions:attack(303,2))
assert(sessions:snapshot(303).matchId ~= a.matchId)
assert(sessions:snapshot(101).tick == 10 and sessions:snapshot(303).tick == 0)
sessions:exit(101)
local remaining = sessions:snapshot(202)
assert(remaining.finished and remaining.winner == 2 and remaining.reason == "Opponent left the match")
sessions:exit(202); sessions:exit(303)
assert(next(sessions.matches) == nil and next(sessions.members) == nil)
assert(sessions:queue(404)); sessions:exit(404)
assert(not sessions:isQueued(404))
assert(sessions:queue(505) and sessions:queue(606))
assert(sessions:snapshot(505).matchId == sessions:snapshot(606).matchId)
sessions:exit(505); assert(sessions:solo(606))
assert(sessions:snapshot(606).mode == "solo")
sessions:exit(606)
assert(next(sessions.matches) == nil)
sessions:exit(999); assert(#sessions.waiting == 0)
print("MATCH_SESSIONS_PASS")
