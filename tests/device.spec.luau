local profiles = require("../src/shared/DeviceProfile")
local desktop = profiles.forInput("KeyboardAndMouse", 1920)
assert(not desktop.mobile and not desktop.compact and desktop.buttonHeight == 40)
local phone = profiles.forInput("Touch", 390)
assert(phone.mobile and phone.compact and phone.buttonHeight == 48)
assert(phone.buttonY + phone.buttonHeight < phone.hintY)
assert(phone.hintY + phone.hintHeight <= phone.headerHeight)
local tablet = profiles.forInput("Touch", 1024)
assert(tablet.mobile and not tablet.compact)
local narrowPC = profiles.forInput("KeyboardAndMouse", 390)
assert(narrowPC.compact and not narrowPC.mobile)
assert(string.find(narrowPC.hint, "mouse wheel", 1, true))
assert(not pcall(profiles.forInput, "Touch", 0))
print("DEVICE_PROFILE_PASS")
local landscape = profiles.forInput("Touch",872,340)
assert(landscape.headerHeight == 128 and landscape.buttonY + landscape.buttonHeight < landscape.headerHeight)
